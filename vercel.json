{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js",
      "headers": {
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Origin": "https://points-dr-mirna.vercel.app",
        "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,PATCH,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type,Authorization,Cookie"
      }
    },
    {
      "src": "/",
      "dest": "public/index.html"
    },
    {
      "src": "/login",
      "dest": "public/login.html"
    },
    {
      "src": "/sign-in",
      "dest": "public/sign-in.html"
    },
    {
      "src": "/dashboard",
      "dest": "public/dashboard.html"
    },
    {
      "src": "/login-dashboard",
      "dest": "public/login-dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
